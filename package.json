{
  "name": "ntucc-meetup-spaces",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:browser": "playwright test",
    "format": "prettier --write public netlify tests *.json *.ts *.toml *.md supabase/migrations/*.sql --ignore-unknown"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@supabase/supabase-js": "^2.95.0",
    "@zxing/browser": "^0.2.1",
    "entities": "^9.0.0",
    "parse5": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
